{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false, "noImplicitAny": false, "skipLibCheck": true, "esModuleInterop": true, "noEmit": true,
    "types": ["node", "vite/client"], "paths": { "@shared/*": ["../src/shared/*"] }
  },
  "include": ["src/**/*", "tests/**/*"]
}
