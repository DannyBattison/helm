{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023"],
    "strict": false, "noImplicitAny": false, "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["node"], "paths": { "@shared/*": ["../src/shared/*"] }
  },
  "include": ["main/**/*", "preload/**/*", "electron.vite.config.ts", "../src/core/**/*", "../src/shared/**/*"]
}
