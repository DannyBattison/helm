{
  "name": "helm-web-companion",
  "version": "0.1.0",
  "private": true,
  "description": "The relay that carries a browser to a helm desktop app: both connect out to it, a GitHub sign-in and a pairing code join them",
  "scripts": {
    "build": "cd ../hosted && vite build -c ../web-companion/vite.config.ts",
    "start": "tsx relay/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12"
  }
}
