# Copy this file to .env and fill it in. .env is not committed.

# The one GitHub username allowed to use this server. Required. That person can run commands inside the container.
HELM_HOSTED_ALLOWED_USER=DannyBattison

# Signs the sign-in cookie: 32+ random characters (`openssl rand -hex 32`). If it is left out, everyone is signed out whenever the container restarts.
HELM_HOSTED_SECRET=

# Optional. By default you sign in from the app, with your Claude or ChatGPT subscription, the first time you open it (one is enough; the
# other can be signed in under Settings). Set one of these instead to skip that:
# an API key (https://console.anthropic.com/settings/keys, billed per use) ...
ANTHROPIC_API_KEY=
# ... or a long-lived subscription token from `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=
# For Codex: an OpenAI API key (https://platform.openai.com/api-keys, billed per use) signs it in without the browser step.
# OPENAI_API_KEY=

# Who agent commits are made as.
HELM_GIT_NAME=
HELM_GIT_EMAIL=
