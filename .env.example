# Copy this file to .env and fill it in. .env is not committed.

# The one GitHub username allowed to use this server. Required. That person can run commands inside the container.
HELM_HOSTED_ALLOWED_USER=DannyBattison

# Signs the sign-in cookie: 32+ random characters (`openssl rand -hex 32`). If it is left out, everyone is signed out whenever the container restarts.
HELM_HOSTED_SECRET=

# How agents authenticate with Anthropic: an API key, from https://console.anthropic.com/settings/keys (create one; it starts with sk-ant-).
# It is billed per use to your Anthropic Console account, separately from a Claude subscription.
ANTHROPIC_API_KEY=

# Alternative to the API key, for a Claude subscription: the long-lived token from running `claude setup-token` on a machine where you are logged in.
# Read the note in hosted-server/README.md about Anthropic's terms before using this on a server.
# CLAUDE_CODE_OAUTH_TOKEN=

# Who agent commits are made as.
HELM_GIT_NAME=
HELM_GIT_EMAIL=
